print("Underflow---\n");
else
{ delel=stack[top1];
top1=top1-1;
}
return(delel);
}

int pop2(stack)
{ int delel=-9999;
if(top2==max)
print("Underflow---\n");
else
{ delel=stack[top2];
top2=top2+1;
}
return(delel);
}

