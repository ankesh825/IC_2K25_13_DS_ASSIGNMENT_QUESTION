int top1=-1,top2=max;

//intitialization

push1(stack,newel)
if(top1+1==top2) return(0);
top1<-top1+1;
stack[top1]<-newel;

push2(stack,newel)
if(top1+1==top2) return(0);
top2<-top2-1;
stack[top2]<-newel;

is full stack-> top1+1==top2? return(1)

Iaempty stack1=>(top1==-1)? :return(1);
Iaempty stack2=>(top2==max)? :return(1);

